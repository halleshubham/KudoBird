generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL  -> restricted app role (subject to Row Level Security)
// DIRECT_URL    -> table owner, used only by `prisma migrate`
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum AuthTokenType {
  VERIFY_EMAIL
  MAGIC_LINK
  PASSWORD_RESET
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssetKind {
  LOGO
  SIGNATURE
  BACKGROUND
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

// ---------------------------------------------------------------------------
// Global tables (no org_id, no RLS)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  googleId        String?   @unique
  isSuperAdmin    Boolean   @default(false)
  totpSecret      String? // AES-GCM encrypted
  totpEnabledAt   DateTime?
  disabledAt      DateTime?
  locale          String    @default("en")
  createdAt       DateTime  @default(now())

  memberships Membership[]
  sessions    Session[]
  tokens      AuthToken[]
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tokenHash      String   @unique
  activeOrgId    String?  @db.Uuid
  mfaVerified    Boolean  @default(false)
  // Set when a super admin is impersonating `userId`
  impersonatorId String?  @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String?       @db.Uuid
  email     String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Plans are configuration. Limits: { "campaigns": 50, "certificatesPerMonth": 10000, ... }
// -1 means unlimited. Features: { "customDomain": false, "api": false, ... }
model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  limits    Json
  features  Json
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  organizations Organization[]
  subscriptions Subscription[]
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Tenant tables (RLS enforced, see prisma/migrations/*_rls)
// ---------------------------------------------------------------------------

model Organization {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  slug           String    @unique
  status         OrgStatus @default(ACTIVE)
  planId         String    @db.Uuid
  // Per-org overrides merged over plan limits/features by the entitlement service
  limitOverrides Json      @default("{}")
  primaryColor   String?
  customDomain   String?   @unique
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  plan          Plan           @relation(fields: [planId], references: [id])
  memberships   Membership[]
  invites       Invite[]
  subscriptions Subscription[]
  usage         UsageCounter[]
  auditLogs     AuditLog[]
  campaigns     Campaign[]
  templates     Template[]
  signatories   Signatory[]
  assets        Asset[]
  entries       Entry[]
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Invite {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @db.Uuid
  email        String
  role         Role
  tokenHash    String    @unique
  invitedById  String    @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  orgId       String             @db.Uuid
  planId      String             @db.Uuid
  status      SubscriptionStatus @default(ACTIVE)
  provider    String? // "razorpay" | "stripe" (future)
  providerRef String?
  currentPeriodEnd DateTime?
  createdAt   DateTime           @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan Plan         @relation(fields: [planId], references: [id])

  @@index([orgId])
}

// metric: certificates_issued | emails_sent | storage_bytes | ...
// period: "YYYY-MM" for monthly metrics, "total" for gauges like storage
model UsageCounter {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @db.Uuid
  metric String
  period String
  value  BigInt @default(0)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, metric, period])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  actorId        String?  @db.Uuid
  // Set when the action was done by a super admin impersonating actorId
  impersonatorId String?  @db.Uuid
  action         String
  entity         String?
  entityId       String?
  meta           Json     @default("{}")
  createdAt      DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// Global font catalogue (synced from Google Fonts metadata). Files are cached on disk.
model Font {
  id         String   @id @default(uuid()) @db.Uuid
  family     String   @unique
  category   String?
  subsets    String[]
  weights    Int[]
  popularity Int      @default(100000) // lower = more popular
  curated    Boolean  @default(false) // shown first in pickers
  bundled    Boolean  @default(false) // ships with the app
  updatedAt  DateTime @updatedAt

  @@index([popularity])
}

model Asset {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @db.Uuid
  kind       AssetKind
  storageKey String
  mime       String
  bytes      Int
  filename   String
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, kind])
}

model Signatory {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  designation String
  assetId     String?  @db.Uuid
  createdAt   DateTime @default(now())

  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaigns CampaignSignatory[]

  @@index([orgId])
}

// orgId NULL = global template managed by the super admin (read-only for orgs, clonable)
model Template {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String?  @db.Uuid
  name          String
  description   String?
  preset        String
  latestVersion Int      @default(1)
  createdAt     DateTime @default(now())

  org       Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions  TemplateVersion[]
  campaigns Campaign[]

  @@index([orgId])
}

// Immutable once written: issued certificates reference the exact version used.
model TemplateVersion {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  orgId      String?  @db.Uuid
  version    Int
  design     Json
  createdById String? @db.Uuid
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

model Campaign {
  id           String         @id @default(uuid()) @db.Uuid
  orgId        String         @db.Uuid
  name         String
  slug         String
  description  String?
  status       CampaignStatus @default(DRAFT)
  locale       String         @default("mr")
  numberPrefix String
  numberSeq    Int            @default(0)
  templateId   String?        @db.Uuid
  // Validated by zod (src/server/campaigns/schema.ts)
  settings     Json           @default("{}")
  formFields   Json           @default("[]")
  createdAt    DateTime       @default(now())
  archivedAt   DateTime?

  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template    Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  signatories CampaignSignatory[]
  entries     Entry[]

  @@unique([orgId, slug])
}

model CampaignSignatory {
  id          String @id @default(uuid()) @db.Uuid
  orgId       String @db.Uuid
  campaignId  String @db.Uuid
  signatoryId String @db.Uuid
  position    Int    @default(0)

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  signatory Signatory @relation(fields: [signatoryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, signatoryId])
}

model Entry {
  id           String      @id @default(uuid()) @db.Uuid
  orgId        String      @db.Uuid
  campaignId   String      @db.Uuid
  name         String
  mobileEnc    String // AES-GCM
  mobileHash   String // keyed blind index, scoped per campaign (duplicate detection)
  emailEnc     String?
  emailHash    String?
  customData   Json        @default("{}")
  status       EntryStatus @default(PENDING)
  consentAt    DateTime?
  consentText  String?
  wallOptIn    Boolean     @default(false)
  locale       String      @default("en")
  ipHash       String?
  createdAt    DateTime    @default(now())
  reviewedById String?     @db.Uuid
  reviewedAt   DateTime?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, mobileHash])
  @@index([orgId, createdAt])
}
