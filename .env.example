# App role (RLS enforced) and owner role (migrations only)
DATABASE_URL=postgresql://kudobird_app:kudobird_app@localhost:5432/kudobird
DIRECT_URL=postgresql://kudobird:kudobird@localhost:5432/kudobird
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
# 32+ random chars; used to hash tokens and derive the PII encryption key
AUTH_SECRET=change-me-change-me-change-me-change-me
# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM="KudoBird <no-reply@localhost>"
SENTRY_DSN=
# Resend webhook signing secret (Resend dashboard -> Webhooks -> your endpoint -> Signing secret)
RESEND_WEBHOOK_SECRET=
# Cloudflare Turnstile (bot check on the public form). Leave empty in development.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_DIR=./storage/files
FONT_CACHE_DIR=./storage/fonts
